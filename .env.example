# Root .env for docker-compose (Postgres + Redis use these passwords)
# Generate: python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=change-me-generate-strong-password
REDIS_PASSWORD=change-me-generate-strong-password

# Optional: baked into frontend at build time (Dokploy rebuild after change)
# NEXT_PUBLIC_API_URL=https://your-domain.com

# Backups (servicio db-backup — cron a medianoche en esta zona horaria)
TZ=America/Lima
# Días de retención de copias en el volumen backup_data (0 = no borrar por antigüedad)
BACKUP_RETENTION_DAYS=60

# Web Push — set on backend service in Dokploy (not required for compose DB/Redis)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_CLAIMS_SUB=mailto:admin@redcardtech.uk
