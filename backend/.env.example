# Database
DATABASE_URL=postgresql+asyncpg://polla_user:strongpassword@localhost:5432/polla_db

# Redis
REDIS_URL=redis://:redispassword@localhost:6379/0

# JWT
JWT_SECRET_KEY=your-256-bit-secret-change-in-production-minimum-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production-minimum-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# API Football (RapidAPI)
FOOTBALL_API_KEY=your-rapidapi-key
FOOTBALL_API_HOST=api-football-v1.p.rapidapi.com

# App
APP_ENV=development
DEBUG=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost,http://127.0.0.1
SECRET_KEY=your-app-secret-key-change-in-production

# Sentry (optional)
SENTRY_DSN=

# Logging
LOG_LEVEL=INFO
