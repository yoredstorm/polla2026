# Database
DATABASE_URL=postgresql+asyncpg://polla_user:GENERATE_STRONG_PASSWORD@localhost:5432/polla_db

# Redis
REDIS_URL=redis://:GENERATE_STRONG_PASSWORD@localhost:6379/0

# JWT — generate with: python scripts/generate_secrets.py
JWT_SECRET_KEY=GENERATE_WITH_scripts_generate_secrets_py
JWT_REFRESH_SECRET=GENERATE_WITH_scripts_generate_secrets_py
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# JWT key rotation (auto-enabled when APP_ENV=production)
JWT_KEY_ROTATION_ENABLED=false
JWT_KEY_ROTATION_DAYS=7
JWT_KEY_GRACE_DAYS=7

# App
APP_ENV=development
DEBUG=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost,http://127.0.0.1

# Sentry (optional)
SENTRY_DSN=

# Logging
LOG_LEVEL=INFO
