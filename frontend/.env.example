# API origin ONLY (no /api/v1 path). Use same host as the browser (127.0.0.1 vs localhost).
# Wrong: /http://localhost:8000  or  http://localhost:8000/api/v1/auth/register
# Dev :3000 → leave unset (uses hostname:8000). Nginx :80 → leave unset (same origin).
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
