# API origin ONLY (no /api/v1 path). Same host as the browser (127.0.0.1 vs localhost).
# Dev (:3000): leave unset → http://hostname:8000
# Prod (nginx/Traefik same domain): leave unset OR https://your-domain.com
# WebSocket URL is derived automatically from this (wss:// when API is https://).
# NEXT_PUBLIC_API_URL=https://redcardtech.uk
